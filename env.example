# ============================================================
# Binance Square Bot — Audience Author v9.1 Dual-Lane
# External cron: python run_bot.py
# Safe local default: DRY_RUN=1
# ============================================================

# --- Publishing ---
SQUARE_API=
BINANCE_SQUARE_OPENAPI_KEY=
PUBLISH_TIMEOUT=90
SQUARE_SKILL_DIR=

# --- Full-post Mistral author ---
# Python calculates market/trade facts. Mistral writes the complete final post.
# Python then validates every number/direction/entry/stop/TP before publishing.
CONTENT_MODE=ai_author
MISTRAL_API=
MISTRAL_MODEL=mistral-small-latest
AI_VARIANTS=6
AI_RETRIES=2
AI_TEMPERATURE=0.72
AI_TIMEOUT=55
EVENT_AI_VARIANTS=6
EVENT_AI_RETRIES=2
EVENT_AI_TEMPERATURE=0.72

# --- Human-feed controls ---
EMOJI_RATE=0.16
QUESTION_EVERY=9
USE_HASHTAGS=0
POST_VARIANTS=16
POST_MIN_CHARS=150
POST_MAX_CHARS=560
MIN_POST_QUALITY=84
MIN_FEED_APPEAL=76
MAX_POST_SIMILARITY=0.46

# --- Public trade plan ---
# Compact posts always carry entry context + TP1 + stop.
# trade_map/risk_first may naturally show entry zone + stop + TP1/TP2/TP3.
MIN_PUBLIC_PLAN_RR=1.30
MIN_PUBLIC_TP3_RR=1.55
MAX_PUBLIC_RISK_PCT=8.0
DECISION_NEAR_ATR=0.30
DECISION_NEAR_PCT=0.25
MAX_STRUCTURAL_DISTANCE_ATR=2.40
MAX_STRUCTURAL_DISTANCE_PCT=4.0
PUBLIC_STOP_BUFFER_ATR=0.75
ENTRY_ZONE_ATR=0.16
ENTRY_ZONE_MAX_PCT=0.35

# --- External cron / distribution gate ---
ENABLE_PACING_LIMITS=0
MIN_GLOBAL_INTERVAL_MIN=20
MAX_POSTS_PER_DAY=72
ENABLE_REACH_GATE=1
MIN_REACH_SCORE=68
COOLDOWN_MIN=240
FORCE_PUBLISH=0
PUBLISH_WINDOWS=
BOT_TIMEZONE=UTC

# --- Persistent state / diagnostics ---
STATE_DIR=state
POST_MEMORY_FILE=post_memory.json
PUBLISHED_HISTORY_FILE=published_history.json
PUBLICATION_STATE_FILE=publication_state.json
BOT_STATUS_FILE=status.json
RUN_LOCK_FILE=bot.lock
LOCK_STALE_MIN=45
LOG_FILE=logs/bot.log
LOG_MAX_BYTES=3000000
LOG_BACKUPS=5

# --- Media ---
PUBLISH_IMAGES=1
PUBLISH_MEDIA_MODE=chart
CARD_WATERMARK=PozitiveHero
CHART_WATERMARK=PozitiveHero

# --- Market universe ---
# 5m is used for freshness, 15m/1h for the cheap first pass,
# 4h/1d only after the audience-led shortlist is built.
TOP_SYMBOLS=120
SHORTLIST_SIZE=36
FINAL_CANDIDATES=20
DATA_WORKERS=8
KLINE_LIMIT=260
MIN_QUOTE_VOLUME=5000000

# --- Technical safety gates ---
MIN_SIGNAL_SCORE=54
MIN_ADX=17.5
MIN_ATR_PCT=0.25
MAX_ATR_PCT=7.0
MIN_RR=1.25
MIN_MTF_ALIGN=0.34
MIN_VOLUME_REL=0.55
MAX_FUNDING_ABS=0.001
STRICT_BTC_FILTER=0
ENABLE_BALANCED_FALLBACK=1
BALANCED_MIN_SIGNAL_SCORE=50
BALANCED_MIN_ADX=16.5
BALANCED_MIN_ATR_PCT=0.18
BALANCED_MAX_ATR_PCT=8.5
BALANCED_MIN_RR=1.05
BALANCED_MIN_MTF_ALIGN=0.33
BALANCED_MIN_VOLUME_REL=0.30
ENABLE_BYBIT_FALLBACK=0

# --- Audience / W2E gates ---
MIN_W2E_MARKET_SCORE=56
W2E_SOFT_FLOOR=40
HOT_W2E_FLOOR=34
MIN_CONVERSION_INTENT=75
MIN_OPPORTUNITY_SCORE=62
MIN_AUDIENCE_DEMAND=24

# Event lane — independent from ADX/R/R hard trade gates.
MIN_EVENT_SCORE=60
EVENT_W2E_FLOOR=42
EVENT_MIN_DEMAND=20
EVENT_LANE_ADVANTAGE=1.5
EVENT_MIN_POST_QUALITY=80
EVENT_MIN_FEED_APPEAL=74
EVENT_MIN_CONVERSION=72
PRELIM_MIN_SCORE=38

# --- Safety ---
DRY_RUN=1
LOG_LEVEL=INFO
