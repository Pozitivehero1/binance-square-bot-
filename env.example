# ============================================================
# Binance Square Bot — v11.2 Signal Quality + Confirmed Entry
# External cron: python run_bot.py
# Safe local default: DRY_RUN=1
# ============================================================

# --- Publishing ---
SQUARE_API=
BINANCE_SQUARE_OPENAPI_KEY=
PUBLISH_TIMEOUT=90
SQUARE_SKILL_DIR=

# --- Full-post AI author ---
# Python calculates and locks all market/trade facts. DeepSeek V4 Pro writes first.
# Mistral is called only if the primary API is unavailable/unusable.
# Python validates numbers/direction/entry/stop/TP and rejects pushy solicitation.
CONTENT_MODE=ai_author
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_MODEL=deepseek/deepseek-v4-pro-free
ORCAROUTER_RETRIES=2
ORCAROUTER_RETRY_BASE_SECONDS=2
ORCAROUTER_RETRY_CAP_SECONDS=6
ORCAROUTER_MAX_RETRY_AFTER=8
MISTRAL_API=
MISTRAL_MODEL=mistral-small-latest
AI_VARIANTS=6
AI_RETRIES=2
AI_TEMPERATURE=0.72
AI_TIMEOUT=55
EVENT_AI_VARIANTS=6
EVENT_AI_RETRIES=2
EVENT_AI_TEMPERATURE=0.72

# --- Human-feed controls ---
EMOJI_RATE=0.16
QUESTION_EVERY=9
USE_HASHTAGS=0
POST_VARIANTS=16
POST_MIN_CHARS=150
POST_MAX_CHARS=560
MIN_POST_QUALITY=84
MIN_FEED_APPEAL=76
MAX_POST_SIMILARITY=0.46

# --- Public trade plan ---
# HARD CONTRACT: every plan_valid post carries direction + entry/zone + stop + TP1 + TP2 + TP3 in public text.
# Observation-only EVENT posts may omit the plan but may not invent one.
MIN_PUBLIC_PLAN_RR=1.30
MIN_PUBLIC_TP3_RR=1.65
MAX_PUBLIC_RISK_PCT=7.0
DECISION_NEAR_ATR=0.24
DECISION_NEAR_PCT=0.20
MAX_STRUCTURAL_DISTANCE_ATR=2.40
MAX_STRUCTURAL_DISTANCE_PCT=4.0
PUBLIC_STOP_BUFFER_ATR=0.75
ENTRY_ZONE_ATR=0.16
ENTRY_ZONE_MAX_PCT=0.35
REQUIRE_NEAR_LEVEL_CONFIRMATION=1

# --- External cron / distribution gate ---
ENABLE_PACING_LIMITS=0
MIN_GLOBAL_INTERVAL_MIN=20
MAX_POSTS_PER_DAY=72
ENABLE_REACH_GATE=1
MIN_REACH_SCORE=69
COOLDOWN_MIN=240
FORCE_PUBLISH=0
PUBLISH_WINDOWS=
BOT_TIMEZONE=UTC

# --- Persistent state / diagnostics ---
STATE_DIR=state
POST_MEMORY_FILE=post_memory.json
PUBLISHED_HISTORY_FILE=published_history.json
PUBLICATION_STATE_FILE=publication_state.json
BOT_STATUS_FILE=status.json
RUN_LOCK_FILE=bot.lock
TRADE_JOURNAL_FILE=trade_journal.json
LOCK_STALE_MIN=45
LOG_FILE=logs/bot.log
LOG_MAX_BYTES=3000000
LOG_BACKUPS=5

# --- Media ---
PUBLISH_IMAGES=1
PUBLISH_MEDIA_MODE=chart
CARD_WATERMARK=PozitiveHero
CHART_WATERMARK=PozitiveHero


# --- v11.1 Trade Outcome Engine ---
# Tracks only new source_post_id-bound full public plans; legacy v11 rows are quarantined.
# Checks closed Binance 1m candles. At most one result follow-up can be published per cron run.
ENABLE_OUTCOME_ENGINE=1
OUTCOME_AVATAR_PATH=assets/pozitivehero_avatar.png
OUTCOME_AI=1
OUTCOME_POST_STOPS=0
OUTCOME_PENDING_ENTRY_HOURS=18
OUTCOME_MAX_AGE_HOURS=72
OUTCOME_MIN_FOLLOWUP_GAP_MIN=45
OUTCOME_MAX_FOLLOWUPS_PER_TRADE=2
OUTCOME_MAX_KLINE_PAGES=7
OUTCOME_MAX_JOURNAL_TRADES=600

# --- Market universe ---
# 5m is used for freshness, 15m/1h for the cheap first pass,
# 4h/1d only after the audience-led shortlist is built.
TOP_SYMBOLS=120
SHORTLIST_SIZE=36
FINAL_CANDIDATES=20
DATA_WORKERS=8
KLINE_LIMIT=260
MIN_QUOTE_VOLUME=5000000

# --- Technical safety gates ---
MIN_SIGNAL_SCORE=54
MIN_ADX=17.5
MIN_ATR_PCT=0.25
MAX_ATR_PCT=7.0
MIN_RR=1.25
MIN_MTF_ALIGN=0.34
MIN_VOLUME_REL=0.55
MAX_FUNDING_ABS=0.001
STRICT_BTC_FILTER=0
ENABLE_BALANCED_FALLBACK=1
BALANCED_MIN_SIGNAL_SCORE=50
BALANCED_MIN_ADX=16.5
BALANCED_MIN_ATR_PCT=0.18
BALANCED_MAX_ATR_PCT=8.5
BALANCED_MIN_RR=1.05
BALANCED_MIN_MTF_ALIGN=0.33
BALANCED_MIN_VOLUME_REL=0.30
ENABLE_BYBIT_FALLBACK=0

# --- Audience / W2E gates ---
MIN_W2E_MARKET_SCORE=56
W2E_SOFT_FLOOR=40
HOT_W2E_FLOOR=34
MIN_CONVERSION_INTENT=75
MIN_OPPORTUNITY_SCORE=63
MIN_AUDIENCE_DEMAND=24

# Event lane — independent from ADX/R/R hard trade gates.
MIN_EVENT_SCORE=60
EVENT_W2E_FLOOR=42
EVENT_MIN_DEMAND=20
EVENT_LANE_ADVANTAGE=1.5
EVENT_MIN_POST_QUALITY=80
EVENT_MIN_FEED_APPEAL=74
EVENT_MIN_CONVERSION=72
VALID_PLAN_EVENT_BONUS=2.5
OBSERVATION_ONLY_EVENT_PENALTY=0.5
PRELIM_MIN_SCORE=38

# --- Safety ---
DRY_RUN=1
LOG_LEVEL=INFO

# v11.2 Adaptive reach + outcome-quality / public Square analytics
# Public profile UID from the Square profile page. No cookie or auth token is required.
SQUARE_PROFILE_UID=6w3LNrVCJ9O4VGhRSf6oug
LEARNING_ONLY=0
ENABLE_ADAPTIVE_RANKING=1
ADAPTIVE_MIN_MATURE_SAMPLES=80
ADAPTIVE_LOOKBACK_DAYS=14
ADAPTIVE_HALF_LIFE_DAYS=7
ADAPTIVE_MAX_TOTAL=14
ADAPTIVE_TICKER_MAX=10
ADAPTIVE_HOUR_MAX=5
ADAPTIVE_LANE_MAX=2.5
ADAPTIVE_BREAKOUT_MAX=3
ADAPTIVE_EXPLORATION_MAX=2.5
ADAPTIVE_SATURATION_MAX=5
ADAPTIVE_OUTCOME_MAX=5
ADAPTIVE_OUTCOME_PRIOR=6
ADAPTIVE_OUTCOME_MIN_CLOSED=3
W2E_PROXY_MAX_BONUS=5
W2E_PROXY_MAX_PENALTY=3
STATS_REFRESH_PAGES=4
ANALYTICS_TZ_OFFSET=3
ANALYTICS_MAX_POSTS=1200
