# ============================================================
# Binance Square Reach Edition
# Скопируйте этот файл в .env и заполните только нужные значения.
# Безопасный режим включён по умолчанию: DRY_RUN=1.
# ============================================================

# --- Публикация ---
# Достаточно заполнить один из двух параметров.
SQUARE_API=
BINANCE_SQUARE_OPENAPI_KEY=
PUBLISH_TIMEOUT=90

# --- Генерация текста ---
# ai_first: один запрос Mistral + локальные безопасные варианты.
# deterministic: полностью локальная генерация без Mistral.
CONTENT_MODE=ai_first
MISTRAL_API=
MISTRAL_MODEL=mistral-small-latest
AI_VARIANTS=6
AI_TEMPERATURE=0.58
AI_TIMEOUT=50

# Авторский голос: analytical | calm | direct | contrarian
AUTHOR_VOICE=analytical

# --- Отбор вариантов публикации ---
POST_VARIANTS=16
POST_MIN_CHARS=260
POST_MAX_CHARS=920
MIN_POST_QUALITY=78
MAX_POST_SIMILARITY=0.52
POST_MEMORY_FILE=post_memory.json

# --- Медиа ---
# adaptive выбирает карточку или график по типу поста.
# Также доступны: card | chart | both | none
PUBLISH_IMAGES=1
PUBLISH_MEDIA_MODE=adaptive
CARD_WATERMARK=PozitiveHero
CHART_WATERMARK=PozitiveHero

# --- Universe и загрузка данных ---
TOP_SYMBOLS=80
SHORTLIST_SIZE=18
FINAL_CANDIDATES=10
DATA_WORKERS=6
KLINE_LIMIT=260
COOLDOWN_MIN=180
MIN_QUOTE_VOLUME=8000000
PUBLISHED_HISTORY_FILE=published_history.json

# --- Строгий фильтр сигналов ---
MIN_SIGNAL_SCORE=54
MIN_ADX=17.5
MIN_ATR_PCT=0.25
MAX_ATR_PCT=7.0
MIN_RR=1.25
MIN_MTF_ALIGN=0.34
MIN_VOLUME_REL=0.55
MAX_FUNDING_ABS=0.001
STRICT_BTC_FILTER=1

# Резерв для near-threshold сетапов. Не отключает обязательные risk/MTF проверки.
ENABLE_BALANCED_FALLBACK=1
BALANCED_MIN_SIGNAL_SCORE=50
BALANCED_MIN_ADX=16.5
BALANCED_MIN_ATR_PCT=0.18
BALANCED_MAX_ATR_PCT=8.5
BALANCED_MIN_RR=1.05
BALANCED_MIN_MTF_ALIGN=0.33
BALANCED_MIN_VOLUME_REL=0.30

# Bybit fallback по умолчанию выключен.
ENABLE_BYBIT_FALLBACK=0

# --- Безопасность запуска ---
# Сначала оставьте 1. Для реальной публикации переключите на 0 только после тестов.
DRY_RUN=1
LOG_LEVEL=INFO
